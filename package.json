{
  "name": "calligraphy-sheet-generator",
  "version": "3.0.8",
  "type": "module",
  "description": "字帖生成器 — Vite 工程化 + Puppeteer PDF矢量生成工具（双轨方案）·v3.0.8 触屏/移动端布局修复（消除整页横向溢出这条主因，fixed 控件不再跑出屏幕）+ 页头横排 + FAB 拖拽限桌面 + 触摸目标 ≥44px + 可重跑布局关口 verify:touch",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "verify:refresh": "node scripts/verify-incremental-refresh.cjs",
    "verify:touch": "node scripts/verify-touch-layout.cjs",
    "pdf": "node puppeteer-pdf.cjs",
    "pdf:help": "node puppeteer-pdf.cjs --help",
    "pdf:test": "node puppeteer-pdf.cjs --text \"床前明月光，疑是地上霜。举头望明月，低头思故乡。\" --output 测试字帖.pdf"
  },
  "dependencies": {
    "cnchar": "^3.0.0",
    "cnchar-words": "^3.0.0",
    "fflate": "^0.8.3",
    "hanzi-writer": "^3.5.0",
    "jspdf": "^2.5.2",
    "lucide-static": "^1.25.0",
    "mammoth": "^1.6.0",
    "pinyin-pro": "^3.0.0",
    "puppeteer": "^23.0.0",
    "svg2pdf.js": "^2.7.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^0.20.0",
    "vite-plugin-singlefile": "^2.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "字帖",
    "pinyin",
    "pdf",
    "puppeteer",
    "矢量",
    "字体练习",
    "书法",
    "vite"
  ],
  "license": "MIT"
}
