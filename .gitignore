# v3.0.5 部署修复（2026-09-19）：字体改为随仓库分发（仅 woff2）
#   原因：CI 下载链路双重失效 —— (1) pip3 install 在 GitHub Ubuntu 24.04 runner 上触发
#   PEP 668（externally-managed-environment）；(2) TW-Kai 唯一上游 anthonyfok/TW-Kai 已 404。
#   两者叠加使 scripts/download-fonts.sh 在 set -e 下中断整个构建 → v3.0.4 起每次部署均失败。
#   现提交 4 个 woff2（共 48 MB，单文件最大 16.6 MB < Cloudflare Pages 25 MiB 限制）。
#   原始 ttf/otf 仍不入库（体积更大，构建与运行时均只引用 woff2）。
public/fonts/*
!public/fonts/*.woff2

# v3.0.1 安全要求：API Key 和个人配置不得上传
.env
.env.*
api-key-*.txt
*api_key*
*apikey*
wrangler.toml
.wrangler/
vercel.json

# v3.0.4：排除本地字体转换临时脚本（一次性工具，不入库）
convert_fonts_woff2.py
convert_one_font.py

# v3.0.3：访问统计系统已移植，functions/ 与 analytics/ 需随仓库发布；
# 仅排除 analytics 内的 node_modules 与本地生成物
analytics/cron-worker/node_modules/
analytics/*.log

# v3.0.4：Vite 每次加载 vite.config.js 会生成带时间戳的临时 bundle，
# 进程被强制结束时可能残留（如 vite.config.js.timestamp-1789727837968-5c39b7e821111.mjs）
vite.config.js.timestamp-*.mjs
